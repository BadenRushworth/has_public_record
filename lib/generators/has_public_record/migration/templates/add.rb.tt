# frozen_string_literal: true

# Adds the public id column (nullable) and its unique index. Then fill existing rows:
#   rails has_public_record:backfill MODEL=YourModel
# and, once every row has an id (rails has_public_record:report), make it required:
#   rails g has_public_record:migration <%= table_name %> --enforce
class <%= migration_class_name %> < ActiveRecord::Migration[<%= ActiveRecord::Migration.current_version %>]
<% if options[:concurrently] -%>
  disable_ddl_transaction! # needed to build an index concurrently; harmless on other databases

<% end -%>
  def change
    add_column :<%= table_name %>, :<%= public_column %>, :string
<% if options[:concurrently] -%>
    # Only PostgreSQL can build an index without locking writes; other databases build it normally.
    index_options = { unique: true }
    index_options[:algorithm] = :concurrently if connection.adapter_name.match?(/postgres/i)
    add_index :<%= table_name %>, :<%= public_column %>, **index_options
<% else -%>
    add_index :<%= table_name %>, :<%= public_column %>, unique: true
<% end -%>
  end
end
